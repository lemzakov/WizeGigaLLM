# Environment Variables Configuration
# Copy this file to .env.local and fill in your actual credentials

# GigaChat API Authorization Key
# This is the Authorization Key (Base64-encoded string) from the Sber developer portal.
# Get it from: https://developers.sber.ru/docs/ru/gigachat/individuals-quickstart#shag-2-poluchenie-tokena-dostupa
# In the portal go to your project → "Authorization data" — copy the full Base64 key as-is.
# DO NOT re-encode it; it must be passed to the GigaChat SDK exactly as provided by Sber.
GIGACHAT_CLIENT_SECRET=your_base64_authorization_key_here

# GigaChat Model Selection
# Options: GigaChat, GigaChat-Max, GigaChat-Pro
GIGACHAT_MODEL=GigaChat

# GigaChat API Base URL
# Note: langchain-gigachat package handles authentication endpoint internally
# Chat API endpoint: https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

# SSL Certificate Verification
# IMPORTANT: Set to false to ignore SSL certificate verification (required for GigaChat API)
# The langchain-gigachat package uses Node.js HTTPS Agent with rejectUnauthorized setting
GIGACHAT_VERIFY_SSL_CERTS=false

# MAX Messenger Bot Token (used by the MAX Bot Test UI at /max-bot)
# Obtain a token from @masterbot in MAX Messenger: https://max.ru/masterbot
MAX_BOT_TOKEN=your_max_bot_token_here
