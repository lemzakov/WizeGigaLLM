# Environment Variables for MAX Bot
# Copy this file to .env and fill in your actual values

# MAX Messenger Bot Token
# Get your token by talking to @masterbot in MAX Messenger and creating a new bot
MAX_BOT_TOKEN=your_max_bot_token_here

# GigaChat API Credentials
# Get your credentials from: https://developers.sber.ru/docs/ru/gigachat/individuals-quickstart
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret_here

# GigaChat Model Selection (optional, default: GigaChat)
# Options: GigaChat, GigaChat-Max, GigaChat-Pro
GIGACHAT_MODEL=GigaChat

# SSL Certificate Verification (optional, default: false)
# Set to false to skip SSL verification (required for GigaChat API in most environments)
GIGACHAT_VERIFY_SSL_CERTS=false

# System prompt for the AI assistant (optional)
# Customize the bot's personality and behavior
SYSTEM_PROMPT=Ты полезный AI-ассистент на базе GigaChat. Отвечай кратко и по существу.
